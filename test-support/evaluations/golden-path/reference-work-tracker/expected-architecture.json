      "owns": [
        "apps/api/src/transport"
      ]
    },
    {
      "id": "api-application",
      "name": "API application",
      "owns": [
        "apps/api/src/application"
      ]
    },
    {
      "id": "api-domain",
      "name": "API domain",
      "owns": [
        "apps/api/src/domain"
      ]
    },
    {
      "id": "api-infrastructure",
      "name": "API infrastructure",
      "owns": [
        "apps/api/src/infrastructure"
      ]
    },
    {
      "id": "contracts",
      "name": "Published contracts",
      "owns": [
        "packages/contracts/src"
      ]
    }
  ],
  "publicContracts": [
    {
      "id": "contract.workItem",
      "moduleId": "contracts",
      "kind": "schema",
      "name": "WorkItem"
    },
    {
      "id": "contract.board",
