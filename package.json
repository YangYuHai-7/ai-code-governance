{
  "name": "ai-code-governance",
  "version": "0.2.0",
  "description": "Cross-platform initializer and governance toolkit for AI coding agents.",
  "type": "module",
  "bin": {
    "aicg": "bin/aicg.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "references/",
    "scripts/validate-skill.mjs",
    "scripts/prepublish-check.mjs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:architecture": "node --test test/architecture-boundaries.test.mjs",
    "test:scenarios": "node --test test/real-scenarios/*.test.mjs",
    "validate:skill": "node scripts/validate-skill.mjs && node scripts/validate-skill.mjs --negative-probe",
    "validate": "npm run validate:skill && node bin/aicg.js doctor . --json",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "release:check": "node bin/aicg.js release-check .",
    "prepublishOnly": "npm test && npm run validate && npm run smoke && npm run smoke:package && node scripts/prepublish-check.mjs"
  },
  "keywords": [
    "ai-governance",
    "agent-skills",
    "codex",
    "claude-code",
    "cursor"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YangYuHai-7/ai-code-governance.git"
  }
}
