{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aicg:work-unit:1",
  "title": "One vertical feature work unit",
  "description": "Bounded to 256 KiB. Runtime validation additionally checks repository evidence, canonical Memory IDs, exact approval and current verification input bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "intent", "taskLevel", "reviewMode", "status", "requirements", "design", "scope", "risks", "professionalBoundaries", "roles", "plan", "testCases", "coverage", "qa", "verification", "memory", "references", "approvalPlanHash"],
  "allOf": [{"if": {"properties": {"taskLevel": {"const": "L3"}}}, "then": {"properties": {"design": {"$ref": "#/$defs/text"}}}}],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "intent": {"$ref": "#/$defs/text"},
    "taskLevel": {"enum": ["L2", "L3"]},
    "reviewMode": {"enum": ["single", "quick-review", "independent-pk", "high-consequence-pk"]},
    "status": {"enum": ["draft", "planned", "approved", "implementing", "qa-ready", "verified", "memory-synced", "complete"]},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["summary", "acceptanceCriteria"], "properties": {"summary": {"$ref": "#/$defs/text"}, "acceptanceCriteria": {"$ref": "#/$defs/texts", "minItems": 1}}},
    "design": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "scope": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "paths"], "properties": {"id": {"$ref": "#/$defs/id"}, "paths": {"$ref": "#/$defs/paths", "minItems": 1}}}},
    "risks": {"$ref": "#/$defs/ids"},
    "professionalBoundaries": {"type": "array", "maxItems": 16, "items": {"type": "object", "description": "The canonical approval professional-boundary shape: id, humanReviewRequired:true, qualification, jurisdiction, decisionAuthority:human-only, reason."}},
    "roles": {"type": "object", "additionalProperties": false, "required": ["selected", "recommendations"], "properties": {"selected": {"$ref": "#/$defs/ids"}, "recommendations": {"$ref": "#/$defs/ids"}}},
    "plan": {"$ref": "#/$defs/texts", "minItems": 1},
    "testCases": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "category", "kind", "required", "description", "testPath"], "properties": {"id": {"$ref": "#/$defs/id"}, "category": {"enum": ["success", "failure", "abnormal", "boundary", "extreme", "risk"]}, "kind": {"enum": ["unit", "integration"]}, "required": {"type": "boolean"}, "description": {"$ref": "#/$defs/text"}, "testPath": {"$ref": "#/$defs/path"}}}},
    "coverage": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["entityId", "testCaseIds", "gap"], "properties": {"entityId": {"$ref": "#/$defs/id"}, "testCaseIds": {"$ref": "#/$defs/ids"}, "gap": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}}}},
    "manualCoverage": {"type": "array", "maxItems": 160, "description": "Complete per-source public-surface inventories for unsupported or dynamic syntax. Operator-declared, source/evidence bound, never a static completeness claim. No second canonical entity ID scheme.", "items": {"$ref": "#/$defs/manualInventory"}},
    "testabilityGaps": {"type": "array", "maxItems": 160, "description": "Explicit unresolved gaps always block completion.", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sourceSha256", "reason", "referenceIds"], "properties": {"path": {"$ref": "#/$defs/path"}, "sourceSha256": {"$ref": "#/$defs/hash"}, "reason": {"$ref": "#/$defs/text"}, "referenceIds": {"$ref": "#/$defs/ids", "minItems": 1}}}},
    "qa": {"type": "object", "additionalProperties": false, "required": ["additions", "applicability", "results"], "properties": {"additions": {"$ref": "#/$defs/ids"}, "applicability": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["category", "status", "reason"], "properties": {"category": {"enum": ["abnormal", "boundary", "extreme", "risk"]}, "status": {"enum": ["applicable", "not-applicable"]}, "reason": {"$ref": "#/$defs/text"}}}}, "results": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/result"}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {"command": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "memory": {"type": "object", "additionalProperties": false, "required": ["decision", "reason", "paths", "updatedOwners"], "properties": {"decision": {"enum": ["update", "no-memory-impact"]}, "reason": {"$ref": "#/$defs/text"}, "paths": {"$ref": "#/$defs/paths"}, "updatedOwners": {"$ref": "#/$defs/ids"}}},
    "references": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "approvalPlanHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "Normalized repository-relative regular-file path; no traversal, absolute paths, .git, symlinks or link ancestors."},
    "ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "texts": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "paths": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "manualInventory": {"type": "object", "additionalProperties": false, "required": ["path", "sourceSha256", "reason", "referenceIds", "evidenceLevel", "noPublicSurface", "entries"], "properties": {"path": {"$ref": "#/$defs/path"}, "sourceSha256": {"$ref": "#/$defs/hash"}, "reason": {"$ref": "#/$defs/text"}, "referenceIds": {"$ref": "#/$defs/ids", "minItems": 1}, "evidenceLevel": {"const": "operator-declared"}, "noPublicSurface": {"type": "boolean"}, "entries": {"type": "array", "maxItems": 1000, "items": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "symbol", "testCaseIds"], "properties": {"kind": {"const": "public-method"}, "symbol": {"$ref": "#/$defs/text"}, "testCaseIds": {"$ref": "#/$defs/ids", "minItems": 1}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "method", "apiPath", "testCaseIds"], "properties": {"kind": {"const": "api"}, "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]}, "apiPath": {"type": "string", "pattern": "^/", "maxLength": 4000}, "testCaseIds": {"$ref": "#/$defs/ids", "minItems": 1}}}]}}}, "allOf": [{"if": {"properties": {"noPublicSurface": {"const": true}}}, "then": {"properties": {"entries": {"maxItems": 0}}}, "else": {"properties": {"entries": {"minItems": 1}}}}]},
    "result": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "workUnitId", "caseId", "status"], "properties": {"schemaVersion": {"const": 1}, "workUnitId": {"$ref": "#/$defs/id"}, "caseId": {"$ref": "#/$defs/id"}, "status": {"enum": ["passed", "failed", "blocked", "not-applicable"]}, "reason": {"$ref": "#/$defs/text"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "source", "command", "planDigest", "inputDigest", "commandDigest", "outputDigest", "resultsDigest", "evidenceDigest", "exitCode", "status"], "properties": {"schemaVersion": {"const": 1}, "source": {"const": "operator-declared"}, "command": {"$ref": "#/$defs/text"}, "planDigest": {"$ref": "#/$defs/hash"}, "inputDigest": {"$ref": "#/$defs/hash"}, "commandDigest": {"$ref": "#/$defs/hash"}, "outputDigest": {"$ref": "#/$defs/hash"}, "resultsDigest": {"$ref": "#/$defs/hash"}, "evidenceDigest": {"$ref": "#/$defs/hash"}, "exitCode": {"const": 0}, "status": {"const": "passed"}}}
  }
}
