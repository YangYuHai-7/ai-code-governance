{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicg.dev/contracts/held-out-evaluation-set-v1-schema.json",
  "title": "AICG Held-Out Evaluation Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "requirement",
          "repositoryDigest",
          "requirementDigest",
          "platforms",
          "structurallyDistinct"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "repositoryDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirementDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "structurallyDistinct": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
