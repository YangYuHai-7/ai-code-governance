{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicg.dev/contracts/requirement-ir-v2-schema.json",
  "title": "AICG Requirement IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "summary", "actors", "goals", "scope", "nonGoals", "preconditions", "businessRules", "stateTransitions", "inputs", "outputs", "failures", "permissions", "dataLifecycle", "nfrs", "rollout", "rollback", "acceptanceScenarios", "assumptions", "openQuestions", "ownerDecisions", "sourceEvidence"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "actors": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "goals"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "goals": { "$ref": "#/$defs/textArray" } } } },
    "goals": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "actorId", "statement"], "properties": { "id": { "$ref": "#/$defs/id" }, "actorId": { "$ref": "#/$defs/id" }, "statement": { "$ref": "#/$defs/text" } } } },
    "scope": { "$ref": "#/$defs/textArray" },
    "nonGoals": { "$ref": "#/$defs/textArray" },
    "preconditions": { "$ref": "#/$defs/textArray" },
    "businessRules": { "$ref": "#/$defs/idStatementArray" },
    "stateTransitions": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "from", "event", "to"], "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/text" }, "event": { "$ref": "#/$defs/text" }, "to": { "$ref": "#/$defs/text" }, "guard": { "$ref": "#/$defs/text" } } } },
    "inputs": { "$ref": "#/$defs/fieldArray" },
    "outputs": { "$ref": "#/$defs/fieldArray" },
    "failures": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "condition", "outcome"], "properties": { "id": { "$ref": "#/$defs/id" }, "condition": { "$ref": "#/$defs/text" }, "outcome": { "$ref": "#/$defs/text" } } } },
    "permissions": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "actorId", "action", "effect"], "properties": { "id": { "$ref": "#/$defs/id" }, "actorId": { "$ref": "#/$defs/id" }, "action": { "$ref": "#/$defs/text" }, "effect": { "enum": ["allow", "deny"] }, "condition": { "$ref": "#/$defs/text" } } } },
    "dataLifecycle": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "data", "retention", "deletion"], "properties": { "id": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/text" }, "retention": { "$ref": "#/$defs/text" }, "deletion": { "$ref": "#/$defs/text" } } } },
    "nfrs": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "category", "requirement"], "properties": { "id": { "$ref": "#/$defs/id" }, "category": { "$ref": "#/$defs/text" }, "requirement": { "$ref": "#/$defs/text" } } } },
    "rollout": { "type": "object", "additionalProperties": false, "required": ["strategy", "safeguards"], "properties": { "strategy": { "$ref": "#/$defs/text" }, "safeguards": { "$ref": "#/$defs/textArray" } } },
    "rollback": { "type": "object", "additionalProperties": false, "required": ["trigger", "action"], "properties": { "trigger": { "$ref": "#/$defs/text" }, "action": { "$ref": "#/$defs/text" } } },
    "acceptanceScenarios": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "given", "when", "then"], "properties": { "id": { "$ref": "#/$defs/id" }, "given": { "$ref": "#/$defs/textArray" }, "when": { "$ref": "#/$defs/text" }, "then": { "$ref": "#/$defs/textArray" } } } },
    "assumptions": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "statement", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "statement": { "$ref": "#/$defs/text" }, "status": { "enum": ["stated", "confirmed", "rejected"] } } } },
    "openQuestions": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "question", "material", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "question": { "$ref": "#/$defs/text" }, "material": { "type": "boolean" }, "status": { "enum": ["open", "answered", "deferred"] }, "answer": { "$ref": "#/$defs/text" } } } },
    "ownerDecisions": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "questionId", "decision", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "questionId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "decision": { "$ref": "#/$defs/text" }, "status": { "enum": ["proposed", "approved", "rejected"] } } } },
    "sourceEvidence": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "source", "level", "digest"], "properties": { "id": { "$ref": "#/$defs/id" }, "source": { "$ref": "#/$defs/text" }, "level": { "enum": ["stated", "reachable", "enforced", "verified"] }, "digest": { "$ref": "#/$defs/digest" } } } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "textArray": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/text" } },
    "idStatementArray": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": { "id": { "$ref": "#/$defs/id" }, "statement": { "$ref": "#/$defs/text" } } } },
    "fieldArray": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "type", "rules"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "type": { "$ref": "#/$defs/text" }, "required": { "type": "boolean" }, "rules": { "$ref": "#/$defs/textArray" } } } }
  }
}
