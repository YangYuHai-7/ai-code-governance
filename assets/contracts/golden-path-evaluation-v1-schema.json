{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicg.dev/contracts/golden-path-evaluation-v1-schema.json",
  "title": "AICG Golden Path Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "packId",
    "agent",
    "requirementPath",
    "requirementDigest",
    "level",
    "verdict",
    "environment",
    "matrix",
    "trace",
    "budget",
    "failureHistory",
    "cleanup",
    "entrypoint",
    "rollback",
    "gaps",
    "evaluatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "real",
        "live"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "real": {
          "type": "boolean"
        },
        "live": {
          "type": "boolean"
        }
      }
    },
    "requirementPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "requirementDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "level": {
      "enum": [
        "E0-generated",
        "E1-deterministic",
        "E2-integrated",
        "E3-agent-executable"
      ]
    },
    "verdict": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "incomplete"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "capabilities"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64
              },
              "status": {
                "enum": [
                  "passed",
                  "blocked"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "runId",
        "requiredGateIds",
        "resolvedGateIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-run"
          ]
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredGateIds": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "resolvedGateIds": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "architecture",
        "patch",
        "test",
        "evidence",
        "review"
      ],
      "properties": {
        "requirement": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "patch": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "test": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentTurns",
        "elapsedMs"
      ],
      "properties": {
        "agentTurns": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failureHistory": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "clean",
            "failed"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "entrypoint": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "rollback": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "gaps": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "evaluatedAt": {
      "type": "string",
      "maxLength": 64
    }
  }
}
