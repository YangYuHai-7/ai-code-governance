{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicg.dev/contracts/qualified-user-acceptance-v1-schema.json",
  "title": "AICG Qualified User Acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "participant",
    "observer",
    "implementerIdentity",
    "digests",
    "decisionsRequested",
    "ownerQuestions",
    "elapsedMinutes",
    "recoveryActions",
    "localRun",
    "residualGaps",
    "outcome",
    "recordedAt",
    "evaluation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "identity"
      ],
      "properties": {
        "class": {
          "enum": [
            "qualified-human",
            "implementer",
            "ai"
          ]
        },
        "stackFamiliarity": {
          "enum": [
            "unfamiliar",
            "familiar"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "identity"
      ],
      "properties": {
        "class": {
          "enum": [
            "independent-human",
            "implementer",
            "ai"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "implementerIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "pack",
        "run",
        "repository"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pack": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "decisionsRequested": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "ownerQuestions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "material",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "material": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "resolved",
              "open"
            ]
          }
        }
      }
    },
    "elapsedMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "recoveryActions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intervention",
          "hidden"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "intervention": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    },
    "localRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "entrypoint"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "residualGaps": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "recordedAt": {
      "type": "string",
      "maxLength": 64
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "gaps": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  }
}
