{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "gates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "applicability", "required", "purpose", "timeoutMs", "maxOutputBytes", "artifactBudgetBytes", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "applicability": { "enum": ["always", "risk-activated", "path-activated"] },
          "required": { "type": "boolean" },
          "purpose": { "type": "string" },
          "timeoutMs": { "type": "integer", "minimum": 1 },
          "maxOutputBytes": { "type": "integer", "minimum": 1 },
          "artifactBudgetBytes": { "type": "integer", "minimum": 0 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
