{
  "schema_version": 1,
  "agents": [
    {
      "id": "codex",
      "label": "Codex",
      "built_in": true,
      "detect_commands": [
        "codex"
      ],
      "detect_paths": [
        "~/.codex"
      ],
      "detect_paths_by_platform": {
        "darwin": [
          "/Applications/Codex.app"
        ]
      },
      "instruction_entry": "AGENTS.md",
      "skill_directories": [
        ".agents/skills"
      ],
      "rule_directories": [],
      "surfaces": [
        "repository-instructions",
        "skills"
      ],
      "assist": {
        "command": "codex",
        "args": [
          "-C",
          "{target}",
          "{prompt}"
        ]
      }
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
      "built_in": true,
      "detect_commands": [
        "claude"
      ],
      "detect_paths": [
        "~/.claude",
        "~/.claude.json"
      ],
      "detect_paths_by_platform": {
        "darwin": [
          "/Applications/Claude.app"
        ],
        "win32": [
          "%APPDATA%/Claude"
        ]
      },
      "instruction_entry": "CLAUDE.md",
      "skill_directories": [
        ".claude/skills"
      ],
      "rule_directories": [],
      "surfaces": [
        "repository-instructions",
        "skills"
      ],
      "assist": {
        "command": "claude",
        "args": [
          "{prompt}"
        ]
      }
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "built_in": true,
      "detect_commands": [
        "cursor-agent"
      ],
      "detect_paths": [
        "~/.cursor"
      ],
      "detect_paths_by_platform": {
        "darwin": [
          "/Applications/Cursor.app"
        ],
        "win32": [
          "%LOCALAPPDATA%/Programs/cursor/Cursor.exe"
        ],
        "linux": [
          "/usr/bin/cursor",
          "~/.local/share/applications/cursor.desktop"
        ]
      },
      "instruction_entry": "AGENTS.md",
      "skill_directories": [
        ".agents/skills"
      ],
      "rule_directories": [
        ".cursor/rules"
      ],
      "surfaces": [
        "repository-instructions",
        "rules",
        "skills"
      ],
      "assist": {
        "command": "cursor-agent",
        "args": [
          "{prompt}"
        ]
      }
    },
    {
      "id": "github-copilot",
      "label": "GitHub Copilot",
      "built_in": true,
      "inferable": false,
      "detect_commands": [
        "copilot"
      ],
      "detect_paths": [
        "~/.copilot",
        "~/.config/github-copilot"
      ],
      "instruction_entry": ".github/copilot-instructions.md",
      "skill_directories": [
        ".github/skills"
      ],
      "rule_directories": [
        ".github/instructions"
      ],
      "surfaces": [
        "repository-instructions",
        "agent-instructions",
        "skills"
      ],
      "assist": null
    },
    {
      "id": "generic",
      "label": "Generic AGENTS.md-compatible agent",
      "built_in": false,
      "detect_commands": [],
      "detect_paths": [],
      "instruction_entry": "AGENTS.md",
      "skill_directories": [
        ".agents/skills"
      ],
      "rule_directories": [],
      "surfaces": [],
      "assist": null
    },
    {
      "id": "deepseek",
      "label": "DeepSeek Harness",
      "built_in": false,
      "detect_commands": [
        "dsh"
      ],
      "detect_paths": [
        "~/.dsh"
      ],
      "detect_paths_by_platform": {
        "darwin": [
          "/Applications/DSH Desktop.app"
        ]
      },
      "instruction_entry": "AGENTS.md",
      "skill_directories": [
        ".dsh/skills"
      ],
      "rule_directories": [],
      "surfaces": [
        "repository-instructions",
        "skills"
      ],
      "assist": {
        "command": "dsh",
        "args": [
          "--profile",
          "headless",
          "{prompt}"
        ]
      }
    }
  ]
}
