{
  "schema_version": 1,
  "product_line": "ai-code-governance",
  "evidence_levels": [
    "certified",
    "supported",
    "unverified",
    "unsupported"
  ],
  "lifecycle_states": [
    "active",
    "planned",
    "deprecated"
  ],
  "integrations": [
    {
      "id": "openspec-change-governance",
      "kind": "change-governance",
      "lifecycle": "active",
      "evidence": "unverified",
      "upstream": {
        "project": "Fission-AI/OpenSpec",
        "license": "MIT",
        "source_checked_at": "2026-09-07",
        "version_policy": "observe-target-installation",
        "official_urls": [
          "https://github.com/Fission-AI/OpenSpec",
          "https://github.com/Fission-AI/OpenSpec/blob/main/docs/getting-started.md",
          "https://github.com/Fission-AI/OpenSpec/blob/main/docs/customization.md"
        ],
        "refresh_required": true
      },
      "detect": {
        "path_any": [
          "openspec/config.yaml",
          "openspec/specs",
          "openspec/changes"
        ],
        "command_any": [
          "openspec --version"
        ]
      },
      "capabilities": [
        "proposal",
        "behavior-specification",
        "delta-specification",
        "design-artifact",
        "implementation-task-list",
        "change-validation",
        "spec-synchronization",
        "change-archive"
      ],
      "overlaps": [
        "requirement-intake",
        "design-document",
        "implementation-plan",
        "task-list",
        "completion-lifecycle"
      ],
      "authority_rule": "When explicitly selected, OpenSpec owns current product behavior and active change artifacts; docs/ai owns AI governance, and the task runtime references rather than copies the change.",
      "validation_sources": [
        "installed OpenSpec version output",
        "project OpenSpec schema resolution",
        "project OpenSpec change validation",
        "project delivery and behavior gates"
      ]
    }
  ]
}
